// DMS Window Rules - Managed by Dux Modular Shell
// Do not edit manually - changes may be overwritten

// @id=wr_1795281715740507437 @name=me.proton.Mail
window-rule {
    match app-id="^me.proton.Mail$"
    open-floating false
    open-maximized true
}

// @id=wr_1795511452852467383 @name=dev.duxlabs.files
window-rule {
    match app-id="^dev.duxlabs.files$"
}

// @id=dms_rule_3 @name=
window-rule {
    match app-id="^steam_app_\\d+$"
    match app-id="^gamescope$"
    variable-refresh-rate true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
